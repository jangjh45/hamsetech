# =============================================
# hamsetech 환경변수 설정
# 사용법: cp .env.example .env 후 값을 채워주세요
# .env 파일은 절대 Git에 커밋하지 마세요!
# =============================================

# ── Docker (프로덕션) ───────────────────────────
# NAS 등에서 호스트 80이 이미 사용 중이면 기본 8080 사용
# FRONTEND_HOST_PORT=8080

# ── Database ──────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hamsetech
DB_USERNAME=hamsetech
DB_PASSWORD=

# ── JWT ───────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열을 사용하세요
JWT_SECRET=

# ── Admin 계정 (초기 설정용) ──────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# 첫 기동에만 true로 두고, 계정 생성 뒤에는 false로 바꾸세요.
ADMIN_BOOTSTRAP_ENABLED=true
# 운영에서는 false를 유지하세요.
ADMIN_SEED_SAMPLE_DATA=false

# 운영(prod) 전용입니다. Nginx 뒤에서는 같은 오리진이라 보통 건드릴 일이 없고,
# 프론트를 별도 도메인으로 서비스할 때만 정확한 origin을 쉼표로 나열하세요.
# 개발 중 사설망 IP(192.168.x.x) 접속은 application-dev.yml이 이미 허용하며,
# 대역이 다르면 DEV_CORS_ALLOWED_ORIGINS로 덮어쓰세요.
# CORS_ALLOWED_ORIGINS=https://hamsetech.example.com

# ── 스키마 ────────────────────────────────────
# Hibernate의 스키마 검증 수준. 기본 validate — 엔티티와 실제 스키마가 어긋나면
# 기동이 멈춥니다. 테이블을 만들고 고치는 일은 Flyway가 합니다.
# 운영에 Flyway를 처음 붙일 때만 none으로 한 번 낮췄다가 되돌리세요.
# HIBERNATE_DDL_AUTO=validate

# ── 로그인 시도 제한 ──────────────────────────
# 연속 실패가 이 횟수에 닿으면 계정을 잠근다. 잠긴 동안의 시도는 비밀번호 대조
# 전에 끊기므로 감사 로그도 더 쌓이지 않는다.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# ── 프록시 헤더 ───────────────────────────────
# 기본 none. 앱이 직접 노출된 상태에서 X-Forwarded-For를 믿으면 클라이언트가
# 감사 로그의 IP를 위조할 수 있다. Nginx 등이 앞단에서 헤더를 덮어쓰는 배포에서만
# framework로 켠다. (docker-compose.prod.yml은 이미 켜 두었다.)
# FORWARD_HEADERS_STRATEGY=framework

# ── 공지 첨부파일 ─────────────────────────────
# 업로드 파일이 쌓이는 경로. 도커에서는 compose가 /app/uploads 볼륨으로 넣어 준다.
# 이 파일들은 DB 덤프에 들어가지 않으므로 백업 대상에 따로 넣어야 한다.
# UPLOAD_DIR=./uploads
# 글에 붙지 못한 첨부를 지우기까지의 시간 (0 이하면 정리하지 않음)
# UPLOAD_ORPHAN_RETENTION_HOURS=24

# ── OAuth2 (사용 시 주석 해제) ────────────────
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
