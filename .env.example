# =============================================
# hamsetech 환경변수 설정
# 사용법: cp .env.example .env 후 값을 채워주세요
# .env 파일은 절대 Git에 커밋하지 마세요!
# =============================================

# ── Docker (프로덕션) ───────────────────────────
# NAS 등에서 호스트 80이 이미 사용 중이면 기본 8080 사용
# FRONTEND_HOST_PORT=8080

# ── Database ──────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hamsetech
DB_USERNAME=hamsetech
DB_PASSWORD=

# ── JWT ───────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열을 사용하세요
JWT_SECRET=

# ── Admin 계정 (초기 설정용) ──────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# 첫 기동에만 true로 두고, 계정 생성 뒤에는 false로 바꾸세요.
ADMIN_BOOTSTRAP_ENABLED=true
# 운영에서는 false를 유지하세요.
ADMIN_SEED_SAMPLE_DATA=false

# 개발 서버가 다른 origin에서 API를 제공할 때만 정확한 origin을 쉼표로 나열하세요.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.0.30:5173

# ── 공지 첨부파일 ─────────────────────────────
# 업로드 파일이 쌓이는 경로. 도커에서는 compose가 /app/uploads 볼륨으로 넣어 준다.
# 이 파일들은 DB 덤프에 들어가지 않으므로 백업 대상에 따로 넣어야 한다.
# UPLOAD_DIR=./uploads
# 글에 붙지 못한 첨부를 지우기까지의 시간 (0 이하면 정리하지 않음)
# UPLOAD_ORPHAN_RETENTION_HOURS=24

# ── OAuth2 (사용 시 주석 해제) ────────────────
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
